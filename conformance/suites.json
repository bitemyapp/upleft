{
  "corpus": [
    "corpus"
  ],
  "exclude": [
    "corpus/workspace/",
    "corpus/spotlight/"
  ],
  "suites": [
    {
      "name": "probe",
      "command": "probe",
      "output": "png",
      "serial": true,
      "only": [
        "corpus/generated/docs/Docs__sample.md",
        "corpus/generated/docs/README.md",
        "corpus/generated/agent/agent-40.md",
        "corpus/generated/spec/spec-0001.md"
      ],
      "variants": [
        [],
        [
          "--dark"
        ],
        [
          "--width",
          "640",
          "--height",
          "900"
        ]
      ]
    },
    {
      "name": "markup",
      "command": "markup",
      "output": "json",
      "variants": [
        []
      ]
    },
    {
      "name": "parse",
      "command": "parse",
      "output": "json",
      "variants": [
        []
      ]
    },
    {
      "name": "core-text",
      "command": "core-text",
      "output": "json",
      "variants": [[]]
    },
    {
      "name": "core-io",
      "command": "core-text",
      "output": "json",
      "variants": [[]],
      "input": "txt",
      "only": ["corpus/core-io/"]
    },
    {
      "name": "unicode",
      "command": "unicode",
      "output": "json",
      "variants": [[]],
      "input": "txt",
      "only": ["corpus/unicode/"]
    },
    {
      "name": "parse-io",
      "command": "parse",
      "output": "json",
      "variants": [[]],
      "input": "txt",
      "only": [
        "core-io/adversarial.txt", "core-io/adversarial-crlf.txt", "core-io/utf8.txt", "core-io/utf8-bom.txt",
        "core-io/utf8-double-bom.txt", "core-io/crlf.txt", "core-io/cr.txt", "core-io/mixed.txt",
        "core-io/crlf-no-trailing.txt", "core-io/trailing-cr.txt", "core-io/only-newlines.txt", "core-io/one-byte.txt",
        "core-io/nul-bytes.txt", "core-io/mostly-nul.txt"
      ]
    },
    {
      "name": "decorate",
      "command": "decorate",
      "output": "json",
      "variants": [
        [
          "--mode",
          "live"
        ],
        [
          "--mode",
          "source"
        ],
        [
          "--mode",
          "live",
          "--dark"
        ],
        [
          "--mode",
          "live",
          "--theme",
          "Nord"
        ],
        [
          "--mode",
          "live",
          "--theme",
          "Warm Dark",
          "--dark"
        ],
        [
          "--mode",
          "live",
          "--theme",
          "High Contrast"
        ]
      ]
    },
    {
      "name": "incremental",
      "command": "incremental",
      "output": "json",
      "variants": [
        ["--mode", "live"],
        ["--mode", "source"],
        ["--mode", "read"]
      ]
    },
    {
      "name": "displaymap",
      "command": "displaymap",
      "output": "json",
      "variants": [
        ["--mode", "live"],
        ["--mode", "read"],
        ["--mode", "source"]
      ]
    },
    {
      "name": "clipboard",
      "command": "clipboard",
      "output": "json",
      "variants": [[]]
    },
    {
      "name": "render",
      "command": "render",
      "output": "png",
      "serial": true,
      "variants": [
        [
          "--mode",
          "live"
        ],
        [
          "--mode",
          "live",
          "--dark"
        ],
        [
          "--mode",
          "source"
        ],
        [
          "--mode",
          "live",
          "--width",
          "1400",
          "--height",
          "1000"
        ]
      ]
    },
    {
      "name": "stylesheet",
      "command": "stylesheet",
      "output": "json",
      "only": [
        "corpus/generated/agent/agent-40.md"
      ],
      "variants": [
        [
          "--theme",
          "High Contrast"
        ],
        [
          "--theme",
          "High Contrast",
          "--dark"
        ],
        [
          "--theme",
          "Nord"
        ],
        [
          "--theme",
          "Nord",
          "--dark"
        ],
        [
          "--theme",
          "Paper Light"
        ],
        [
          "--theme",
          "Paper Light",
          "--dark"
        ],
        [
          "--theme",
          "Solarized Light"
        ],
        [
          "--theme",
          "Solarized Light",
          "--dark"
        ],
        [
          "--theme",
          "System"
        ],
        [
          "--theme",
          "System",
          "--dark"
        ],
        [
          "--theme",
          "Warm Dark"
        ],
        [
          "--theme",
          "Warm Dark",
          "--dark"
        ]
      ]
    },
    {
      "name": "highlight",
      "command": "highlight",
      "output": "json",
      "variants": [
        []
      ]
    },
    {
      "name": "mermaid-replay",
      "command": "mermaid-replay",
      "output": "json",
      "input": "elkrec",
      "variants": [[]]
    },
    {
      "name": "mermaid-parse",
      "command": "mermaid-parse",
      "output": "json",
      "input": "mmd",
      "variants": [[]]
    },
    {
      "name": "mermaid-layout",
      "command": "mermaid-layout",
      "output": "json",
      "input": "mmd",
      "variants": [
        [],
        ["--dark"],
        ["--theme", "Nord"],
        ["--theme", "High Contrast"]
      ]
    },
    {
      "name": "mermaid",
      "command": "mermaid",
      "output": "png",
      "input": "mmd",
      "variants": [
        [],
        ["--dark"],
        ["--theme", "Nord"],
        ["--theme", "High Contrast"]
      ]
    },
    {
      "name": "vscode-theme",
      "command": "vscode-theme",
      "output": "json",
      "input": "jsonc",
      "only": [
        "corpus/themes/"
      ],
      "variants": [
        []
      ]
    },
    {
      "name": "elk",
      "command": "elk",
      "output": "json",
      "input": "json",
      "only": [
        "corpus/elk/"
      ],
      "variants": [
        []
      ]
    },
    {
      "name": "math-image",
      "command": "math",
      "output": "png",
      "input": "tex",
      "variants": [
        ["--theme", "Paper Light"],
        ["--theme", "Paper Light", "--dark"],
        ["--theme", "Nord"],
        ["--theme", "Nord", "--dark"],
        ["--theme", "Warm Dark"],
        ["--theme", "Warm Dark", "--dark"],
        ["--theme", "High Contrast"],
        ["--theme", "High Contrast", "--dark"],
        ["--theme", "Solarized Light"],
        ["--theme", "Solarized Light", "--dark"],
        ["--theme", "System"],
        ["--theme", "System", "--dark"]
      ]
    },
    {
      "name": "math-tree",
      "command": "math-tree",
      "output": "json",
      "input": "tex",
      "variants": [
        ["--theme", "Paper Light"],
        ["--theme", "Paper Light", "--dark"],
        ["--theme", "Nord"],
        ["--theme", "Nord", "--dark"],
        ["--theme", "Warm Dark"],
        ["--theme", "Warm Dark", "--dark"],
        ["--theme", "High Contrast"],
        ["--theme", "High Contrast", "--dark"],
        ["--theme", "Solarized Light"],
        ["--theme", "Solarized Light", "--dark"],
        ["--theme", "System"],
        ["--theme", "System", "--dark"]
      ]
    },
    {
      "name": "html-export",
      "command": "html-export",
      "oracle": "app",
      "output": "json",
      "only": ["corpus/"],
      "keyPath": true,
      "depends": ["corpus/workspace/"],
      "variants": [
        ["--theme", "High Contrast"],
        ["--theme", "High Contrast", "--dark"],
        ["--theme", "Nord"],
        ["--theme", "Nord", "--dark"],
        ["--theme", "Paper Light"],
        ["--theme", "Paper Light", "--dark"],
        ["--theme", "Solarized Light"],
        ["--theme", "Solarized Light", "--dark"],
        ["--theme", "System"],
        ["--theme", "System", "--dark"],
        ["--theme", "Warm Dark"],
        ["--theme", "Warm Dark", "--dark"],
        ["--theme", "Paper Light", "--print"],
        ["--theme", "Warm Dark", "--dark", "--print"]
      ]
    },
    {
      "name": "spotlight",
      "command": "spotlight",
      "oracle": "app",
      "output": "json",
      "keyPath": true,
      "only": ["corpus/generated/", "corpus/highlight/", "corpus/spotlight/"],
      "variants": [[]]
    },
    {
      "name": "down-cli",
      "command": "down-cli",
      "oracle": "app",
      "output": "json",
      "input": "json",
      "only": ["corpus/down-cli/"],
      "stamps": ["target/downright-cli/release/down"],
      "variants": [[]]
    },
    {
      "name": "workspace",
      "command": "workspace",
      "oracle": "app",
      "output": "json",
      "input": "json",
      "only": ["corpus/workspace-queries/"],
      "depends": ["corpus/workspace/"],
      "variants": [[]]
    },
    {
      "name": "find",
      "command": "find",
      "oracle": "app",
      "output": "json",
      "input": "json",
      "only": ["corpus/find/"],
      "depends": ["corpus/workspace/", "corpus/generated/agent/", "corpus/generated/docs/"],
      "variants": [[]]
    },
    {
      "name": "palette",
      "command": "palette",
      "oracle": "app",
      "output": "json",
      "input": "json",
      "only": ["corpus/palette/"],
      "variants": [[]]
    },
    {
      "name": "formats",
      "command": "formats",
      "oracle": "app",
      "output": "json",
      "input": "json",
      "only": ["corpus/formats/"],
      "variants": [[]]
    },
    {
      "name": "updater",
      "command": "updater",
      "oracle": "app",
      "output": "json",
      "input": "json",
      "only": ["corpus/updater/"],
      "variants": [[]],
      "stamps": [
        "corpus/updater/feeds/basic.xml",
        "corpus/updater/feeds/binary-junk.xml",
        "corpus/updater/feeds/bom-crlf.xml",
        "corpus/updater/feeds/channels.xml",
        "corpus/updater/feeds/critical.xml",
        "corpus/updater/feeds/deltas.xml",
        "corpus/updater/feeds/empty.xml",
        "corpus/updater/feeds/html-release-notes.xml",
        "corpus/updater/feeds/informational.xml",
        "corpus/updater/feeds/latin1.xml",
        "corpus/updater/feeds/malformed-not-xml.xml",
        "corpus/updater/feeds/malformed-unclosed.xml",
        "corpus/updater/feeds/markdown-release-notes.xml",
        "corpus/updater/feeds/minimum-system-version.xml",
        "corpus/updater/feeds/missing-fields.xml",
        "corpus/updater/feeds/multiple-items.xml",
        "corpus/updater/feeds/non-ascii.xml",
        "corpus/updater/feeds/odd-versions.xml"
      ]
    },
    {
      "name": "local-ai",
      "command": "local-ai",
      "oracle": "app",
      "output": "json",
      "input": "json",
      "only": ["corpus/local-ai/"],
      "variants": [[]]
    }
  ]
}
