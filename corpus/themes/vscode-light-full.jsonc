{
  "$schema": "vscode://schemas/color-theme",
  "name": "Synthetic Light Full",
  "type": "light",
  "colors": {
    "editor.background": "#FAFAF7",
    "editor.foreground": "#2B2B2B",
    "focusBorder": "#0066CC",
    "textLink.foreground": "#0A58CA",
    "button.background": "#123456",
    "descriptionForeground": "#6A6A6A",
    "editorWidget.background": "#F0F0EC",
    "sideBar.background": "#EDEDE8",
    "panel.border": "#DDDDD5",
    "editorGroup.border": "#CCCCCC",
    "editor.selectionBackground": "#ADD6FF80",
    "editor.findMatchHighlightBackground": "#EA5C0055",
    "editor.findMatchBackground": "#A8AC94",
    "editorInfo.foreground": "#1A85FF",
    "editorError.foreground": "#E51400",
    "errorForeground": "#A1260D",
    "editorWarning.foreground": "#BF8803",
    "gitDecoration.addedResourceForeground": "#587C0C",
    "gitDecoration.deletedResourceForeground": "#AD0707",
    "gitDecoration.modifiedResourceForeground": "#895503",
    "editorGutter.addedBackground": "#48985D",
    "editorGutter.deletedBackground": "#E51400"
  },
  "tokenColors": [
    { "settings": { "foreground": "#111111" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#008000", "fontStyle": "italic" } },
    { "scope": "comment.line.double-slash", "settings": { "foreground": "#009000" } },
    { "scope": "string.quoted", "settings": { "foreground": "#A31515" } },
    { "scope": "string", "settings": { "foreground": "#B31515" } },
    { "scope": "keyword", "settings": { "foreground": "#0000FF" } },
    { "scope": "keyword.control.flow.js", "settings": { "foreground": "#AF00DB" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#000000" } },
    { "scope": "storage.modifier", "settings": { "foreground": "#0000AA" } },
    { "scope": "constant.numeric.integer", "settings": { "foreground": "#098658" } },
    { "scope": "constant.language", "settings": { "foreground": "#0000FF" } },
    { "scope": "entity.name.type, support.type, entity.name.class", "settings": { "foreground": "#267F99" } },
    { "scope": "support.function", "settings": { "foreground": "#795E26" } },
    { "scope": "variable", "settings": { "foreground": "#001080" } },
    { "scope": "variable.other.readwrite", "settings": { "foreground": "#002080" } },
    { "scope": "punctuation", "settings": { "foreground": "#303030" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#E50000" } },
    { "scope": "meta.diff.header", "settings": { "foreground": "#000080" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#098658" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#A31515" } }
  ],
  "semanticHighlighting": true
}
